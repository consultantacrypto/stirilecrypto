{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "stirilecrypto.ro" }],
      "destination": "https://www.stirilecrypto.ro/$1",
      "statusCode": 301
    }
  ],
  "crons": [
    {
      "path": "/api/etf/cron",
      "schedule": "0 18 * * 1-5"
    }
  ]
}
