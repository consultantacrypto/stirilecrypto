# Public Supabase (browser / SSR anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin emails for Crypto Azi (and privileged server actions).
# Required and fail-closed: empty / missing blocks all admin mutations.
# Example: admin@example.com,editor@example.com
ADMIN_EMAIL_ALLOWLIST=
